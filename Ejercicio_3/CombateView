package Ejercicio_3;
import java.util.List;
import java.util.Scanner;

public class CombateView {
    private Scanner scanner;

    public CombateView() {
        scanner = new Scanner(System.in);
    }

    public void mostrarMensaje(String mensaje) {
        System.out.println(mensaje);
    }

    public void mostrarEstado(Jugador jugador, Enemigo enemigo) {
        System.out.println("\n=============================================");
        System.out.println("JUGADOR: " + jugador.getNombre() + " | HP: " + jugador.getSalud() + " | LVL: " + jugador.getNivel());
        String arma = (jugador.getArmaEquipada() != null) ? jugador.getArmaEquipada().getNombre() : "Desarmado";
        System.out.println("Arma equipada: " + arma);
        System.out.println("---------------------------------------------");
        System.out.println("ENEMIGO: " + enemigo.getNombre() + " (" + enemigo.getTipo() + ") | HP: " + enemigo.getSalud() + " | LVL: " + enemigo.getNivel());
        System.out.println("=============================================");
    }

    public void mostrarMenu() {
        System.out.println("\n--- ACCIONES ---");
        System.out.println("1. Atacar");
        System.out.println("2. Usar Objeto");
        System.out.println("3. Equipar Arma");
        System.out.println("0. Huir");
        System.out.print("Elige una accion: ");
    }

    public void mostrarInventario(List<Item> inventario) {
        System.out.println("\n--- INVENTARIO ---");
        if (inventario.isEmpty()) {
            System.out.println("Vacio.");
        } else {
            for (int i = 0; i < inventario.size(); i++) {
                System.out.println((i + 1) + ". " + inventario.get(i).toString());
            }
        }
    }

    public String solicitarEntrada() {
        return scanner.nextLine();
    }
}
